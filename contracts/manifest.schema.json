{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "manifest.schema.json",
 "title": "site/data/manifest.json",
 "description": "Entry point for the static site. Lists regions, global layers, sources, methods and the continuity strategy. contract_version 1.x.",
 "type": "object",
 "required": [
  "contract_version",
  "file",
  "kind",
  "dataset_version",
  "build_time",
  "strategy",
  "sources",
  "methods",
  "regions",
  "global_layers",
  "eras"
 ],
 "additionalProperties": false,
 "properties": {
  "contract_version": {
   "type": "string",
   "pattern": "^1\\.[0-9]+\\.[0-9]+$"
  },
  "file": {
   "const": "manifest"
  },
  "kind": {
   "enum": [
    "real",
    "fixture"
   ]
  },
  "watermark": {
   "type": "string",
   "minLength": 1
  },
  "dataset_version": {
   "type": "string",
   "minLength": 1
  },
  "build_time": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
  },
  "generated_by": {
   "$ref": "#/$defs/generated_by"
  },
  "strategy": {
   "type": "object",
   "description": "Which continuity strategy builds record_value. Never assume 2012: the per-month record_source in series.json is authoritative.",
   "required": [
    "id",
    "status",
    "summary"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "enum": [
      "A",
      "B",
      "C",
      "undecided"
     ]
    },
    "status": {
     "enum": [
      "undecided",
      "provisional",
      "selected",
      "rejected_all"
     ]
    },
    "summary": {
     "type": "string"
    },
    "decided_on": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "evidence_ref": {
     "type": [
      "string",
      "null"
     ]
    },
    "candidates": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "label"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "enum": [
         "A",
         "B",
         "C"
        ]
       },
       "label": {
        "type": "string"
       },
       "status": {
        "enum": [
         "under_evaluation",
         "provisional",
         "selected",
         "rejected"
        ]
       }
      }
     }
    }
   }
  },
  "eras": {
   "type": "array",
   "description": "Era boundaries are data, not code. Frontend must read them from here.",
   "items": {
    "type": "object",
    "required": [
     "id",
     "label",
     "start",
     "end"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "enum": [
       "terra_only",
       "modis_only",
       "overlap",
       "aqua_drift",
       "post_modis"
      ]
     },
     "label": {
      "type": "string"
     },
     "start": {
      "$ref": "#/$defs/month"
     },
     "end": {
      "anyOf": [
       {
        "$ref": "#/$defs/month"
       },
       {
        "type": "null"
       }
      ]
     },
     "basis": {
      "type": "string",
      "description": "Why this boundary: data availability, measured drift change-point, projected end, etc."
     },
     "boundary_status": {
      "enum": [
       "actual",
       "measured",
       "projected",
       "assumed"
      ]
     }
    }
   }
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "url",
     "sensor",
     "platform",
     "years",
     "product",
     "retrieved"
    ],
    "additionalProperties": false,
    "properties": {
     "url": {
      "type": "string"
     },
     "sensor": {
      "enum": [
       "MODIS",
       "VIIRS"
      ]
     },
     "platform": {
      "$ref": "#/$defs/platform"
     },
     "years": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 2000,
       "maximum": 2100
      }
     },
     "product": {
      "type": "string",
      "description": "e.g. 'FIRMS MCD14ML C6.1 standard', 'FIRMS VNP14IMGTDL NRT'"
     },
     "version": {
      "type": [
       "string",
       "null"
      ]
     },
     "archive": {
      "enum": [
       "standard",
       "nrt",
       "mixed",
       "unknown"
      ]
     },
     "retrieved": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
     },
     "sha256": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "methods": {
   "type": "array",
   "description": "Registry of derived/modelled methods referenced by series.json and validation.json.",
   "items": {
    "type": "object",
    "required": [
     "id",
     "label",
     "version",
     "value_kind",
     "status"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
     },
     "label": {
      "type": "string"
     },
     "version": {
      "type": "string"
     },
     "value_kind": {
      "enum": [
       "modelled",
       "derived"
      ]
     },
     "status": {
      "enum": [
       "provisional",
       "validated",
       "failed",
       "not_evaluated"
      ]
     },
     "trained_on_years": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     },
     "doc_ref": {
      "type": [
       "string",
       "null"
      ]
     },
     "role": {
      "enum": [
       "candidate",
       "baseline"
      ],
      "description": "Added in 1.1.0; optional. baseline = the simple comparator (ratio) a candidate must beat."
     }
    }
   }
  },
  "regions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "role",
     "bbox",
     "status",
     "series_path"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
     },
     "name": {
      "type": "string"
     },
     "role": {
      "enum": [
       "pilot",
       "control",
       "explore"
      ]
     },
     "description": {
      "type": "string"
     },
     "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "description": "[west, south, east, north] in degrees, WGS84.",
      "items": {
       "type": "number",
       "minimum": -180,
       "maximum": 180
      }
     },
     "geometry_path": {
      "type": [
       "string",
       "null"
      ],
      "description": "Optional GeoJSON/TopoJSON polygon relative to site/data/."
     },
     "area_km2_land": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 0
     },
     "status": {
      "enum": [
       "validated",
       "provisional",
       "explore_only",
       "fixture"
      ]
     },
     "status_reason": {
      "type": "string"
     },
     "method": {
      "type": [
       "string",
       "null"
      ]
     },
     "method_version": {
      "type": [
       "string",
       "null"
      ]
     },
     "trained_on_years": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     },
     "held_out_years": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     },
     "latest_standard_month": {
      "anyOf": [
       {
        "$ref": "#/$defs/month"
       },
       {
        "type": "null"
       }
      ]
     },
     "latest_month": {
      "anyOf": [
       {
        "$ref": "#/$defs/month"
       },
       {
        "type": "null"
       }
      ]
     },
     "series_path": {
      "type": "string"
     },
     "export_paths": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "audit_flags": {
      "type": "array",
      "description": "Added in 1.2.0; optional. Pre-registered audit diagnostics for this region (e.g. pre-2012 C1 checks, D6 relabel steps). Copied from analysis/results, never recomputed by the exporter.",
      "items": {
       "type": "object",
       "required": [
        "id",
        "label",
        "value",
        "unit",
        "ci_low",
        "ci_high",
        "threshold",
        "flagged",
        "source_ref",
        "scope"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[A-Za-z0-9_]+$",
         "description": "e.g. C1_terra_aqua_ratio, C1_frp_floor, D6_relabel_2018, D6_relabel_2023"
        },
        "label": {
         "type": "string",
         "minLength": 1
        },
        "value": {
         "type": [
          "number",
          "null"
         ]
        },
        "unit": {
         "type": "string"
        },
        "ci_low": {
         "type": [
          "number",
          "null"
         ]
        },
        "ci_high": {
         "type": [
          "number",
          "null"
         ]
        },
        "ci_level": {
         "type": [
          "number",
          "null"
         ],
         "exclusiveMinimum": 0,
         "exclusiveMaximum": 1
        },
        "threshold": {
         "type": [
          "number",
          "null"
         ]
        },
        "threshold_rule": {
         "type": "string",
         "description": "How flagged follows from value/CI and threshold, e.g. '|slope| CI excludes 0 and |value| > threshold'."
        },
        "flagged": {
         "type": [
          "boolean",
          "null"
         ],
         "description": "null = could not be evaluated (see note)."
        },
        "n": {
         "type": [
          "integer",
          "null"
         ],
         "minimum": 0
        },
        "source_ref": {
         "$ref": "#/$defs/source_ref"
        },
        "scope": {
         "enum": [
          "region",
          "pooled",
          "global"
         ]
        },
        "period": {
         "type": [
          "string",
          "null"
         ],
         "description": "e.g. '2003-2011'"
        },
        "note": {
         "type": "string"
        }
       }
      }
     },
     "tier": {
      "enum": [
       "core",
       "control",
       "stretch",
       "explore",
       "m2_primary"
      ],
      "description": "Added 1.2.1 (optional at 1.2.0, required by the validator at >= 1.2.1). Must agree with analysis/results/region_selection.json: control_region -> control; other core_regions -> core; stretch_region -> stretch; explore_only -> explore. 1.4.0: m2_primary = a primary M2 confirmation region; must be listed in analysis/results_m2/confirm/regions.json primary (real builds), and its series must carry value_kind."
     },
     "m2": {
      "type": "object",
      "description": "Added 1.4.0, optional (required for tier m2_primary): M2 status and scope.",
      "required": [
       "status_label",
       "outcome",
       "predictor_platform",
       "validated_window",
       "validation_path"
      ],
      "properties": {
       "status_label": {
        "type": "string"
       },
       "outcome": {
        "enum": [
         "SUCCESS",
         "FAILURE",
         "INCONCLUSIVE"
        ]
       },
       "predictor_platform": {
        "enum": [
         "noaa20"
        ]
       },
       "calibration_path": {
        "type": "string"
       },
       "method_validation": {
        "type": "string"
       },
       "validated_window": {
        "type": "object",
        "required": [
         "start",
         "end"
        ],
        "properties": {
         "start": {
          "type": "string"
         },
         "end": {
          "type": "string"
         }
        }
       },
       "design": {
        "type": "string"
       },
       "validation_path": {
        "type": "string"
       },
       "region_status_ref": {
        "type": "string"
       },
       "method_id": {
        "type": "string"
       },
       "method_version": {
        "type": "string"
       },
       "lane": {
        "type": "string"
       },
       "fit_years": {
        "type": "array",
        "items": {
         "type": "integer"
        }
       }
      }
     }
    }
   }
  },
  "global_layers": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "label",
     "path",
     "status"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "status": {
      "enum": [
       "available",
       "pending",
       "fixture"
      ]
     }
    }
   }
  },
  "validation_path": {
   "type": [
    "string",
    "null"
   ]
  },
  "sensors_path": {
   "type": [
    "string",
    "null"
   ]
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "m2_validation_path": {
   "type": "string",
   "description": "Added 1.4.0, optional: m2_validation.json (M2 held-out evidence)."
  },
  "m2_regions": {
   "type": "array",
   "description": "Added 1.4.0, optional: the M2 confirmation regions (tier m2_primary). Kept apart from regions[] so 1.3 consumers, which read regions[] as the M1-evaluated set, are unaffected. Same item shape as regions[].",
   "items": {
    "$ref": "#/properties/regions/items"
   }
  }
 },
 "if": {
  "properties": {
   "kind": {
    "const": "fixture"
   }
  }
 },
 "then": {
  "required": [
   "watermark"
  ]
 },
 "$defs": {
  "month": {
   "type": "string",
   "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
  },
  "platform": {
   "enum": [
    "terra",
    "aqua",
    "snpp",
    "noaa20",
    "noaa21"
   ]
  },
  "generated_by": {
   "type": "object",
   "required": [
    "tool"
   ],
   "properties": {
    "tool": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "git": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "source_ref": {
   "type": "object",
   "required": [
    "path",
    "key"
   ],
   "additionalProperties": false,
   "properties": {
    "path": {
     "type": "string",
     "pattern": "^analysis/results/"
    },
    "key": {
     "type": "string",
     "minLength": 1
    }
   },
   "description": "Where the number comes from: a file under analysis/results/ and a key/JSON-pointer inside it."
  }
 }
}